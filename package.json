{
  "name": "toolbox",
  "version": "1.0.0",
  "description": "Personal toolbox - dashboard for screen recording, downloading and more",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zmt.toolbox",
    "productName": "Toolbox",
    "files": [
      "**/*",
      "!dist/**",
      "!services/video-downloader/venv/Lib/site-packages/torch/**",
      "!services/video-downloader/venv/Lib/site-packages/torchaudio/**",
      "!services/video-downloader/venv/Lib/site-packages/torchgen/**",
      "!services/video-downloader/venv/Lib/site-packages/functorch/**",
      "!services/video-downloader/venv/Lib/site-packages/nvidia/**",
      "!services/video-downloader/venv/Lib/site-packages/sympy/**",
      "!services/video-downloader/venv/Lib/site-packages/llvmlite/**",
      "!services/video-downloader/venv/Lib/site-packages/numba/**",
      "!services/video-downloader/venv/Lib/site-packages/transformers/**",
      "!services/video-downloader/venv/Lib/site-packages/voxcpm/**",
      "!services/video-downloader/venv/Lib/site-packages/librosa/**",
      "!services/video-downloader/venv/Lib/site-packages/sklearn/**",
      "!services/video-downloader/venv/Lib/site-packages/scipy/**",
      "!services/video-downloader/venv/Lib/site-packages/datasets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toolbox",
      "menuCategory": false,
      "warningsAsErrors": false
    },
    "asar": false
  }
}